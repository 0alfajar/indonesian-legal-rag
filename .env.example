# Legal Atlas environment (copy to .env; never commit .env)

# Answer generation. Without it the demo runs in search-only mode.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
# Optional comma-separated model override; defaults live in src/legal_rag/generation.py
# GEMINI_MODEL=gemini-flash-lite-latest

# Embedding device: cpu | cuda (default: auto)
# LEGAL_RAG_DEVICE=cpu

# HTML demo server (legal-rag serve)
# PORT=8000
# HOST=0.0.0.0
# RATE_LIMIT_PER_MINUTE=20

# Hugging Face deploy (scripts/deploy_hf.py)
# HF_TOKEN=hf_...
# HF_SPACE_ID=your-hf-username/legal-atlas
