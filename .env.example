# Legal Atlas Environment Configuration

# Optional: Google Gemini API key for answer generation
# Without this key, the system runs in search-only mode
# Get your key at: https://ai.google.dev/
GEMINI_API_KEY=your_api_key_here

# Server configuration (optional)
# PORT=8000
# HOST=127.0.0.1

# Model configuration (optional - defaults are set in config.py)
# EMBEDDING_MODEL=intfloat/multilingual-e5-base
# MAX_CHUNK_CHARS=1600
# SEMANTIC_WEIGHT=0.7
